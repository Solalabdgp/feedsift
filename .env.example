# Шаблон. Скопировать в .env и заполнить. .env в .gitignore, коммитить нельзя.
#
# Каждая переменная отдаётся только тем контейнерам, которым она нужна —
# раздача расписана в docker-compose.yml, не через общий env_file.

# --- Feed adapter (нужен только сервису collector) ---
# Учётные данные фида отдельного служебного аккаунта, не личного.
# По сути это read-креды: хранить как пароль, не как "просто URL-параметры".
SOURCE_FEED_USER=
SOURCE_FEED_TOKEN=
# Шаблон URL фида. {sources} подставляется склейкой имён источников.
SOURCE_FEED_URL_TEMPLATE=
SOURCE_USER_AGENT=feedsift/0.1

# --- LLM (нужен только сервису llm-worker) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- LLM: пул запасных ключей main (нужен только llm-worker) ---
# Необязательны: пустые пропускаются, пул деградирует до одного GROQ_API_KEY.
# Только для main — GROQ_API_KEY_BROWSE ниже в пул не входит.
GROQ_API_KEY_MAIN_POOL_1=
GROQ_API_KEY_MAIN_POOL_2=
GROQ_API_KEY_MAIN_POOL_3=

# --- Browse-контур ---
# Второй, независимый мониторинг по смежным нишам. Сервисы collector-browse
# и llm-worker-browse не заработают без этих значений.
#
# SOURCE_FEED_USER_BROWSE/SOURCE_FEED_TOKEN_BROWSE — нужен только collector-browse.
# ОТДЕЛЬНЫЙ служебный аккаунт, НЕ тот же, что у основного контура: смысл в том,
# чтобы не делить с main лимит запросов провайдера.
SOURCE_FEED_USER_BROWSE=
SOURCE_FEED_TOKEN_BROWSE=

# GROQ_API_KEY_BROWSE/GROQ_MODEL_BROWSE — нужен только llm-worker-browse.
# ОТДЕЛЬНЫЙ ключ, НЕ тот же, что у основного GROQ_API_KEY: квота основного
# пайплайна впритык, делить её с browse-контуром означало бы расходовать
# бюджет реальных лидов контура main.
GROQ_API_KEY_BROWSE=
GROQ_MODEL_BROWSE=qwen/qwen3.8-27b

# --- Telegram (нужен только сервису bot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Postgres ---
# Порт наружу не публикуется. Пароль сгенерировать, например:
#   python -c "import secrets; print(secrets.token_hex(24))"
# POSTGRES_PASSWORD и пароль внутри DATABASE_URL должны совпадать — это одно
# и то же значение в двух форматах. docker-compose.yml собирает из них третий
# вариант (DATABASE_URL_SYNC) для миграций автоматически.
POSTGRES_USER=feedsift
POSTGRES_PASSWORD=
POSTGRES_DB=feedsift
DATABASE_URL=postgresql+asyncpg://feedsift:ТОТ_ЖЕ_ПАРОЛЬ@postgres:5432/feedsift

# --- Инфраструктура и логи (не секреты) ---
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
LOG_FORMAT=console
TZ=UTC

# --- Необязательное ---
# Остальные настройки (пороги скоринга, лимиты квоты, интервалы поллинга)
# живут в app/config.py и НЕ пробрасываются через compose — если понадобится
# менять их из .env, переменную нужно явно добавить в environment нужного сервиса.
# Порог уведомления и веса правил меняются на живую из бота: /threshold, /weights.
